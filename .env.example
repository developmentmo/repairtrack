# Copy to .env for docker compose (compose reads .env automatically).
# The Spring `local` profile uses the same defaults, so no app env vars are needed locally.
# NEVER commit a real .env file.

# --- docker compose ---
POSTGRES_DB=repairtrack
POSTGRES_USER=repairtrack
POSTGRES_PASSWORD=repairtrack
POSTGRES_PORT=5432

# --- application (required outside the `local` profile) ---
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/repairtrack
DATABASE_USERNAME=repairtrack
DATABASE_PASSWORD=repairtrack

# Access-token signing secret, >= 32 bytes. Optional in `local` (a dev default exists), REQUIRED elsewhere.
# Generate: openssl rand -base64 48
# JWT_SECRET=

# --- introduced in later phases (not read yet) ---
# S3_ENDPOINT=           # Phase 6
# S3_ACCESS_KEY=         # Phase 6
# S3_SECRET_KEY=         # Phase 6
# S3_BUCKET=             # Phase 6
