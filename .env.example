# Copy to .env for docker compose (compose reads .env automatically).
# The Spring `local` profile uses the same defaults, so no app env vars are needed locally.
# NEVER commit a real .env file.

# --- docker compose ---
POSTGRES_DB=repairtrack
POSTGRES_USER=repairtrack
POSTGRES_PASSWORD=repairtrack
POSTGRES_PORT=5432

# --- application (required outside the `local` profile) ---
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/repairtrack
DATABASE_USERNAME=repairtrack
DATABASE_PASSWORD=repairtrack

# Access-token signing secret, >= 32 bytes. Optional in `local` (a dev default exists), REQUIRED elsewhere.
# Generate: openssl rand -base64 48
# JWT_SECRET=

# --- sharing ---
# Base of public share links ({base}/v/{token}). Optional in `local`, REQUIRED elsewhere.
# PUBLIC_BASE_URL=https://repairtrack.nl

# --- document storage (S3-compatible; Garage locally) ---
# Optional in `local` (defaults match docker-compose), REQUIRED elsewhere: S3_REGION, S3_BUCKET.
# S3_ENDPOINT=http://localhost:3900
# S3_PUBLIC_ENDPOINT=          # host clients use for downloads, if different (e.g. http://10.0.2.2:3900 for the Android emulator)
# S3_REGION=garage
# S3_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
# S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# S3_BUCKET=repairtrack-documents
