# Edge proxy settings. Copy to /opt/repairtrack/edge/.env (chmod 600). No secrets here, only host names.
# Every host name needs a DNS A (and AAAA, if the VPS has IPv6) record pointing at this VPS.

# Let's Encrypt account e-mail (expiry warnings).
ACME_EMAIL=admin@example.nl

# Production: web app (+ /api on the same host), API for the mobile apps, presigned document downloads.
PRODUCTION_APP_DOMAIN=repairtrack.example.nl
PRODUCTION_API_DOMAIN=api.repairtrack.example.nl
PRODUCTION_FILES_DOMAIN=files.repairtrack.example.nl

# Staging: the same three, on separate names.
STAGING_APP_DOMAIN=staging.repairtrack.example.nl
STAGING_API_DOMAIN=api.staging.repairtrack.example.nl
STAGING_FILES_DOMAIN=files.staging.repairtrack.example.nl
