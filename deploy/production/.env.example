# RepairTrack PRODUCTION secrets and settings.
# On the VPS: /opt/repairtrack/production/.env, owner repairtrack-deploy, chmod 600. NEVER commit the real file.
# Create it with:  /opt/repairtrack/production/scripts/init-env.sh   (fills in random secrets)
# then edit the domains and the SMTP settings.
# Read by Docker Compose only (never sourced by a shell). Use KEY=value lines; no quotes needed.

# Container images (lower-case GitHub owner). The version is NOT set here: deploy.sh writes it to release.env.
IMAGE_REGISTRY=ghcr.io/your-github-owner

# Public host names (must match edge/.env and the DNS records).
APP_DOMAIN=repairtrack.example.nl
FILES_DOMAIN=files.repairtrack.example.nl

# PostgreSQL (only reachable inside the stack's internal network).
POSTGRES_DB=repairtrack
POSTGRES_USER=repairtrack
POSTGRES_PASSWORD=__GENERATE__

# HS256 signing key for access tokens, at least 32 bytes.
JWT_SECRET=__GENERATE__

# Object storage (the stack's own Garage). Key format required by Garage: GK + 32 hex chars; secret: 64 hex.
S3_BUCKET=repairtrack-documents
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
GARAGE_RPC_SECRET=__GENERATE__

# Outgoing e-mail (verification, password reset, disputes): your SMTP provider.
# Port 587 = STARTTLS (default). Port 465 = implicit TLS: set MAIL_SMTP_SSL=true and MAIL_SMTP_STARTTLS=false
# (TransIP: smtp.transip.email, 465, username = the full mailbox address).
MAIL_HOST=smtp.example.nl
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
MAIL_FROM=RepairTrack <noreply@example.nl>

# Optional
# RDW_APP_TOKEN=
# BACKEND_MEMORY_LIMIT=1g
# DATABASE_POOL_SIZE=10
# Use external S3 instead of Garage (then also set S3_REGION and S3_PATH_STYLE_ACCESS):
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_PUBLIC_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Backups (scripts/backup-db.sh): days to keep local dumps; the 7 newest are always kept.
BACKUP_RETENTION_DAYS=30
